FROM oven/bun:1.4.2 AS bun
FROM node:22-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build:server

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends arp-scan iproute2 iputils-ping ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/dist-server /app/dist-server
ENV NODE_ENV=production NETHUB_DATA_DIR=/data NETHUB_WEB_DIR=/app/dist-server/web
EXPOSE 8080
CMD ["node","dist-server/server.mjs"]
